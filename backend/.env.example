# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Express trust proxy: false (direct), true, or number of proxy hops (e.g. 1 behind Nginx)
TRUST_PROXY=false

# Database (PostgreSQL via Supabase, Neon, or Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/spoorf_cloud?schema=public"

# Redis (for active session tracking & rate limiting)
REDIS_URL="redis://localhost:6379"

# Asymmetric Cryptography (RS256 JWT Token Signing)
JWT_PRIVATE_KEY_PATH="./keys/license-private.pem"
JWT_PUBLIC_KEY_PATH="./keys/license-public.pem"
JWT_ISSUER="https://api.spoorf.app"

# Payment Gateway (Midtrans Sandbox / Production)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false
