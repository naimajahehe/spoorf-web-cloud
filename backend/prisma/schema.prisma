datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LicenseTier {
  FREE
  PRO
  VIP
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  passwordHash          String
  name                  String?
  role                  String         @default("user") // "user" | "admin"
  isEmailVerified       Boolean        @default(false)
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  license               License?
  sessions              Session[]
  transactions          Transaction[]
  redeemedKeys          LicenseKey[]
}

model License {
  id                  String       @id @default(uuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                LicenseTier  @default(FREE)
  maxCuts             Int          @default(5)
  canThrottle         Boolean      @default(false)
  canGateway          Boolean      @default(false)
  canAutoreblock      Boolean      @default(false)
  canArsenal          Boolean      @default(false)
  canDeepFingerprint  Boolean      @default(false)
  cloudSync           Boolean      @default(false)
  expiresAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Session {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String       @unique // UUID generated by desktop client
  deviceName     String?      // e.g. "Laptop Asus ROG - Win11"
  platform       String?      // e.g. "win32", "darwin", "linux"
  appVersion     String?      // e.g. "2.41.36"
  ipAddress      String?
  isRevoked      Boolean      @default(false)
  revokedAt      DateTime?
  revokedReason  String?      // e.g. "Exceeded concurrent session limit (kicked by new login)"
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([sessionId])
}

model Transaction {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           String         @unique // Midtrans order_id: "ORDER-SPOORF-..."
  grossAmount       Int            // in IDR (e.g. 50000)
  targetTier        LicenseTier
  durationDays      Int            // e.g. 30, 365, or 9999 (lifetime)
  status            PaymentStatus  @default(PENDING)
  paymentType       String?        // "qris", "bank_transfer", "gopay"
  snapToken         String?
  snapRedirectUrl   String?
  metadata          Json?          // Raw gateway payload for forensic auditing
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([orderId])
}

model LicenseKey {
  id            String       @id @default(uuid())
  key           String       @unique // e.g. "PRO-SENTINEL-XXXX-YYYY"
  tier          LicenseTier  @default(PRO)
  durationDays  Int          @default(30)
  isUsed        Boolean      @default(false)
  usedByUserId  String?
  user          User?        @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)
  usedAt        DateTime?
  expiresAt     DateTime?    // expiration of the voucher key itself
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([key])
  @@index([usedByUserId])
}